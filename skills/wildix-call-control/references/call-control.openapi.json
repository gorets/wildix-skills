{
  "openapi": "3.0.0",
  "info": {
    "title": "Wildix PBX Call Control",
    "version": "1.0",
    "description": "The Call Control operations of the Wildix PBX API (WMS), taken from https://docs.wildix.com/pbx-openapi.yaml. They live under /api/v2/call-control/ of the user's PBX. The wildix-call-control skill calls them with the user's x-bees login token (Authorization: Bearer <ID token>); the PBX also takes the other schemes listed here."
  },
  "servers": [
    {
      "url": "https://{pbx}/api/v2",
      "variables": {
        "pbx": {
          "default": "demo.wildixin.com",
          "description": "The user's PBX host (with :port when it is not 443)"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Call Control",
      "description": "Call control operations for managing active calls. Available at /api/v2/call-control/"
    }
  ],
  "paths": {
    "/call-control/make-call/": {
      "post": {
        "operationId": "makeCall",
        "summary": "Initiate a new call",
        "description": "Initiate a new outbound call from the specified user to the destination.\n\n**Access Control:**\n- Root admin can specify any user extension via query parameter\n- Regular users can only make calls from their own extension\n\n**Device Selection:**\n- If no deviceContact is provided, the user's active device will be used automatically\n- If no callType is specified, defaults to 'device' type\n\n### Allowed Auth Scopes\n\n- `callcontrol:*`\n- `pbx:*`",
        "tags": [
          "Call Control"
        ],
        "servers": [
          {
            "url": "https://{subdomain}.wildixin.com:{port}/api/v2",
            "variables": {
              "subdomain": {
                "default": "demo",
                "description": "Wildix PBX subdomain"
              },
              "port": {
                "default": 443
              }
            }
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "user",
            "schema": {
              "type": "string"
            },
            "description": "User extension (only for root admins)",
            "example": "101"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "destination"
                ],
                "properties": {
                  "destination": {
                    "type": "string",
                    "description": "Destination number or extension",
                    "example": "102"
                  },
                  "callType": {
                    "type": "string",
                    "description": "Type of call",
                    "enum": [
                      "any",
                      "mobility",
                      "device"
                    ],
                    "default": "device"
                  },
                  "deviceContact": {
                    "type": "string",
                    "description": "Device contact URI (if not provided, uses user's active device)",
                    "example": "sip:101@192.168.1.100"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Call initiated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Call initiated successfully"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "403": {
            "$ref": "#/components/responses/CompanyApiKeyForbidden"
          },
          "503": {
            "description": "Unable to connect to PBX engine"
          }
        },
        "x-wildix-companyApiKeyScope": "callcontrol:*",
        "x-wildix-companyApiKeyAllowedScopes": [
          "callcontrol:*",
          "pbx:*"
        ],
        "security": [
          {
            "OAuth2": []
          },
          {
            "session": []
          },
          {
            "Token": []
          },
          {
            "Bearer": []
          },
          {
            "CompanyApiKey": []
          }
        ]
      }
    },
