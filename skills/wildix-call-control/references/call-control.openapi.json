    "/call-control/set-active-device/": {
      "put": {
        "operationId": "setActiveDevice",
        "summary": "Set active device for calling",
        "description": "Set which device should be used for outgoing calls.\n\n**Device Types:**\n- device: Specific physical device (requires contact and userAgent)\n- mobility: Mobile/forwarding mode\n- any: Ring all devices\n\n**Access Control:**\n- Authenticated users can set their own active device\n- Root admin can set active device for other users (with 'user' parameter)\n\n**Note:** The device user agent must match the pattern supported by Kamailio\n(e.g., Wildix WP, Zero Distance, Android, iOS, Vision, SuperVision, Web, etc.)\n\n### Allowed Auth Scopes\n\n- `callcontrol:*`\n- `pbx:*`",
        "tags": [
          "Call Control"
        ],
        "servers": [
          {
            "url": "https://{subdomain}.wildixin.com:{port}/api/v2",
            "variables": {
              "subdomain": {
                "default": "demo",
                "description": "Wildix PBX subdomain"
              },
              "port": {
                "default": 443
              }
            }
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "user",
            "schema": {
              "type": "string"
            },
            "description": "Extension (only for root admin)",
            "example": "101"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "title": "Physical Device",
                    "description": "Schema for setting a specific physical device",
                    "properties": {
                      "deviceType": {
                        "type": "string",
                        "enum": [
                          "device"
                        ],
