    "/api/v1/channels/{channelId}/read-status": {
      "get": {
        "description": "Lists member read pointers for channels with at most 100 members.\n\n### Allowed Auth Scopes\n\n- messaging:ListChannelMembersReadStatus\n- messaging:read",
        "operationId": "ListChannelMembersReadStatus",
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "description": "Direct-channel ids are the 8-4-4-4-8 slices of the two member ids. An `a_` member id puts `_` in a slice, so the pattern allows it.",
            "schema": {
              "type": "string",
              "maxLength": 32,
              "minLength": 32,
              "pattern": "^[0-9a-z_]{8}\\b-[0-9a-z_]{4}\\b-[0-9a-z_]{4}\\b-[0-9a-z_]{4}\\b-[0-9a-z_]{8}$",
              "description": "Direct-channel ids are the 8-4-4-4-8 slices of the two member ids. An `a_` member id puts `_` in a slice, so the pattern allows it."
