      "UserToInvite": {
        "type": "object",
        "description": "User invitation payload used when creating channels or adding members.",
        "properties": {
          "email": {
            "type": "string",
            "pattern": "^(^[\\w+-]+(\\.[\\w+-]+)*)@(([\\w-]+\\.)+\\w{2,}$)$",
            "description": "Email of the invited user."
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+?[0-9]{4,17}$",
            "description": "Phone number used to find or create the user when email is omitted."
          },
          "name": {
            "type": "string",
            "description": "Optional display name for the invited user."
          },
          "colleague": {
            "type": "boolean",
            "description": "When true, resolve the email as a PBX colleague."
          }
        }
