  "components": {
    "schemas": {
      "AddChannelMemberRequestContent": {
        "type": "object",
        "properties": {
          "silent": {
            "type": "boolean"
          },
          "memberId": {
            "type": "string",
            "maxLength": 12,
            "minLength": 12
          },
          "memberToInvite": {
            "$ref": "#/components/schemas/UserToInvite"
          },
          "hideHistory": {
            "type": "boolean"
          }
        }
      },
      "AddChannelMemberResponseContent": {
        "type": "object",
        "properties": {
          "member": {
            "$ref": "#/components/schemas/ChannelMember"
          }
        },
        "required": [
          "member"
        ]
      },
      "AddChannelMembersRequestContent": {
        "type": "object",
        "properties": {
          "silent": {
            "type": "boolean"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 12,
              "minLength": 12
            }
          },
          "membersToInvite": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserToInvite"
            }
          },
          "hideHistory": {
            "type": "boolean"
          },
          "unreadMessageId": {
            "type": "string",
            "maxLength": 32,
            "minLength": 32,
            "description": "Message id used to seed unread state for added members."
          }
        }
      },
      "AddChannelMembersResponseContent": {
        "type": "object",
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChannelMember"
            }
          }
        },
        "required": [
          "members"
        ]
      },
      "ChannelMember": {
        "type": "object",
        "description": "Channel membership row.",
        "properties": {
          "userId": {
            "type": "string",
            "maxLength": 12,
            "minLength": 12
          },
          "joinedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
            "description": "ISO-8601 UTC timestamp with millisecond precision (e.g. `2026-05-07T05:35:00.000Z`)."
          },
          "role": {
            "$ref": "#/components/schemas/ChannelMemberRole"
          }
        },
        "required": [
          "joinedAt",
          "role",
          "userId"
        ]
      },
      "ChannelMemberReadStatus": {
        "type": "object",
        "description": "Read pointer for one channel member.",
        "properties": {
          "userId": {
            "type": "string",
            "maxLength": 12,
            "minLength": 12
          },
          "lastReadAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
            "description": "ISO-8601 UTC timestamp with millisecond precision (e.g. `2026-05-07T05:35:00.000Z`)."
          },
          "lastReadVisibleSeq": {
            "type": "number",
            "minimum": 0,
            "description": "Monotonic per-channel sequence covering only visible messages. Used for unread counts and read pointers."
          }
        },
        "required": [
          "userId"
        ]
      },
      "ChannelMemberRole": {
        "type": "string",
        "enum": [
          "owner",
          "member",
          "supervisor"
        ]
      },
      "ChannelNotFoundExceptionResponseContent": {
        "type": "object",
        "properties": {
